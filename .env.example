# Backend Database and Authentication
DB_URL=jdbc:postgresql://db:5432/webGIS_DB
DB_USER=webgis_client
DB_PASSWORD=changeme_strong_password
JWT_SECRET=changeme_base64_encoded_secret_min_32_chars
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Database connection details used by pg_dump (DbBackupService) — same DB as DB_URL above,
# decomposed since pg_dump needs discrete host/port/name/credentials, not a JDBC URL.
DATABASE_HOST=db
DATABASE_PORT=2665
DATABASE_NAME=webGIS_DB
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme_postgres_password

# NAS media backup + database backup (see docs/BACKUP-STRATEGY.md)
BACKUP_NAS_ENABLED=false
BACKUP_NAS_MOUNT_PATH=/backup/media
BACKUP_NAS_SYNC_CRON=0 0 3 * * SUN
BACKUP_DB_ENABLED=false
BACKUP_DB_OUTPUT_PATH=/backup/db
BACKUP_STALENESS_THRESHOLD_HOURS=192

# Docker Compose - Database Service
POSTGRES_USER=root
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=webGIS_DB

# Docker Compose - GeoServer Service
GEOSERVER_ADMIN_PASSWORD=changeme_geoserver_password

# Docker Compose - pgAdmin Service
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_pgadmin_password

